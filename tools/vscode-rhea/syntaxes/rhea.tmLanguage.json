{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rhea",
  "scopeName": "source.rhea",
  "patterns": [
    { "name": "comment.line.double-slash.rhea", "match": "//.*$" },
    { "name": "keyword.control.rhea", "match": "\\b(fn|let|mut|const|if|else|while|for|in|return|match|struct|enum|import|try|catch|break|continue|parallel|pipeline)\\b" },
    { "name": "constant.numeric.duration.rhea", "match": "\\b[0-9]+(\\.[0-9]+)?(ms|s)\\b" },
    { "name": "keyword.operator.range.rhea", "match": "\\.\\.=|\\.\\." },
    { "name": "support.function.builtin.rhea", "match": "\\b(print|println|print_inline|input|input_int|input_float|try_parse_int|try_parse_float|sleep|now_ms|is_eof|len|str|assert|assert_eq)\\b" },
    { "name": "storage.type.rhea", "match": "\\b(Int|Float|Bool|String|Unit|Tensor|List|Map|Option|Result)\\b" },
    { "name": "string.quoted.double.rhea", "begin": "\"", "end": "\"" }
  ]
}

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Rhea source files
*.rhea text eol=lf linguist-language=Rhea

# C++, Python, Rust, Shell, and Markdown
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.plist text eol=lf
Makefile text eol=lf

# Windows scripts retain CRLF
*.reg text eol=crlf
*.ps1 text eol=crlf

# Binary assets and archives
*.png binary
*.icns binary
*.ico binary
*.zip binary
